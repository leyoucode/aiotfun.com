---
import { t } from '../utils/i18n';
---

<section class="mx-auto w-full md:w-4/5 max-w-content px-4 pt-12 pb-8 md:px-6 md:pt-16 md:pb-10">
  <div class="flex flex-col items-start gap-3 max-w-prose">
    <h1 class="font-body text-4xl md:text-5xl lg:text-6xl font-bold leading-[1.1] text-text">
      <span class="text-text">AIoT</span><span class="text-accent">Fun</span>
    </h1>
    <p class="text-lg md:text-xl text-text-muted">{t.site.tagline}</p>
    <p class="mt-3 text-base leading-relaxed text-text/85">
      {t.home.hero_summary}
    </p>
    <div class="mt-2 flex flex-wrap gap-3 font-mono text-sm">
      <a href="https://github.com/leyoucode" target="_blank" rel="noopener noreferrer"
         class="inline-flex items-center gap-1.5 rounded-card border border-border bg-card-bg px-4 py-1.5 text-text-muted hover:border-accent hover:text-accent transition-colors">
        GitHub
      </a>
      <a href="https://x.com/AIoTFun" target="_blank" rel="noopener noreferrer"
         class="inline-flex items-center gap-1.5 rounded-card border border-border bg-card-bg px-4 py-1.5 text-text-muted hover:border-accent hover:text-accent transition-colors">
        X
      </a>
    </div>
  </div>
</section>
