---
import BaseLayout from '../layouts/BaseLayout.astro';
import PersonalHero from '../components/PersonalHero.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { t } from '../utils/i18n';
import { getArticles } from '../utils/articles';

const articles = await getArticles();
---

<BaseLayout title={`${t.site.name} — ${t.site.tagline}`} description={t.site.description}>
  <PersonalHero />

  <section class="mx-auto w-full md:w-4/5 max-w-content px-4 md:px-6 pb-16">
    {articles.length > 0 ? (
      <div>
        {articles.map((a) => <ArticleCard article={a} variant="list" />)}
      </div>
    ) : (
      <p class="text-text-muted py-8">{(t as any).home.no_writing}</p>
    )}
  </section>
</BaseLayout>
