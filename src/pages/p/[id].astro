---
import Base from '../../layouts/Base.astro';
import Shelf from '../../components/Shelf.astro';
import { allShelves, formatStars, owner, projects, similarTo, type Project } from '../../lib/projects.ts';
import { AI_WHERE, DIFFICULTY, HARDWARE_ROLES, PLATFORMS, SHELVES } from '../../lib/taxonomy.ts';

export function getStaticPaths() {
  return projects.map((p) => ({ params: { id: p.id }, props: { p } }));
}

const { p } = Astro.props as { p: Project };
const ai = p.ai;
const repoUrl = `https://github.com/${p.repo}`;
const similar = similarTo(p, 12);
const sameShelf = allShelves().find((s) => s.key === ai.shelf)!;
const moreInShelf = { ...sameShelf, items: sameShelf.items.filter((q) => q.id !== p.id) };
const cloneCmd = `git clone ${repoUrl}.git`;
const updated = new Date(p.github.pushedAt).toISOString().slice(0, 10);

const facts = [
  ['主控平台', PLATFORMS[ai.platform]],
  ['动手难度', DIFFICULTY[ai.difficulty]],
  ['GitHub Star', formatStars(p.github.stars)],
  ['License', p.github.license],
  ['最近更新', updated],
  ['分类', SHELVES[ai.shelf]],
];
---

<Base title={ai.title} description={ai.summary}>
  <div class="pt-8">
    <a href="/" class="text-xs text-muted hover:text-teal">← 画廊</a>
    <div class="mt-2 flex items-start justify-between gap-4">
      <div class="min-w-0">
        <h1 class="text-2xl font-bold tracking-tight md:text-3xl">{ai.title}</h1>
        <p class="mt-1 text-sm text-muted">
          作者 <span class="text-ink">{owner(p)}</span> ·
          <a href={repoUrl} target="_blank" rel="noopener" class="font-mono text-xs text-teal hover:underline">github.com/{p.repo}</a>
        </p>
      </div>
      <button
        type="button"
        data-like-btn={p.id}
        aria-pressed="false"
        class="group flex shrink-0 items-center gap-1.5 rounded-full border border-line bg-surface px-3 py-1.5 text-sm text-muted hover:text-ink aria-pressed:border-accent aria-pressed:bg-accent-soft aria-pressed:text-teal"
        aria-label="喜欢这个项目"
      >
        <svg viewBox="0 0 20 20" class="size-4" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <path class="group-aria-pressed:fill-current" d="M10 17s-6.5-4.1-6.5-8.6A3.6 3.6 0 0 1 10 6a3.6 3.6 0 0 1 6.5 2.4C16.5 12.9 10 17 10 17Z"></path>
        </svg>
        <span data-num>0</span>
      </button>
    </div>
  </div>

  <div class="mt-6 grid grid-cols-1 gap-6 lg:grid-cols-[minmax(0,3fr)_minmax(0,2fr)]">
    <div class="overflow-hidden rounded-2xl border border-line bg-surface">
      <img src={`/cards/${p.id}.svg`} alt={`${ai.title} 的结构图：主控、外设和 AI 能力`} width="400" height="250" class="aspect-[8/5] w-full" />
    </div>

    <div class="flex flex-col gap-3">
      <a href={repoUrl} target="_blank" rel="noopener" class="rounded-xl bg-teal px-4 py-3 text-center text-sm font-medium text-white hover:bg-teal/90">去 GitHub 看源码 →</a>
      <button type="button" data-copy={cloneCmd} class="flex items-center justify-between gap-2 rounded-xl border border-line bg-surface px-4 py-2.5 text-left hover:border-teal/40">
        <code class="truncate font-mono text-xs text-muted">{cloneCmd}</code>
        <span class="shrink-0 text-xs text-teal" data-copy-label>复制</span>
      </button>
      <p class="text-sm leading-relaxed">{ai.summary}</p>
      <dl class="mt-1 grid grid-cols-2 gap-x-4 gap-y-3 border-t border-line pt-4 text-sm">
        {facts.map(([k, v]) => (
          <div>
            <dt class="font-mono text-[11px] uppercase tracking-wider text-muted">{k}</dt>
            <dd class="mt-0.5">{v}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>

  <div class="mt-10 grid grid-cols-1 gap-10 lg:grid-cols-[minmax(0,3fr)_minmax(0,2fr)]">
    <article>
      <h2 class="text-lg font-semibold tracking-tight">项目介绍</h2>
      <div class="mt-3 space-y-3 text-[15px] leading-7">
        {ai.intro.split(/\n{2,}/).map((para) => <p>{para}</p>)}
      </div>
      <p class="mt-4 text-xs text-muted">以上内容由 AI 根据仓库 README 整理，可能有误，请以原仓库为准。</p>
    </article>

    <aside class="space-y-8">
      <section>
        <h2 class="text-lg font-semibold tracking-tight">AI 能力</h2>
        <ul class="mt-3 space-y-2">
          {ai.aiCapabilities.map((a) => (
            <li class="flex items-center justify-between rounded-lg border border-accent/40 bg-accent-soft px-3 py-2 text-sm">
              <span class="font-medium text-teal">{a.name}</span>
              <span class="text-xs text-muted">{AI_WHERE[a.where]}</span>
            </li>
          ))}
        </ul>
      </section>
      {ai.hardware.length > 0 && (
        <section>
          <h2 class="text-lg font-semibold tracking-tight">硬件清单</h2>
          <table class="mt-3 w-full text-sm">
            <tbody>
              {ai.hardware.map((h) => (
                <tr class="border-b border-line last:border-0">
                  <td class="py-2 pr-3">{h.name}</td>
                  <td class="py-2 text-right text-xs text-muted">{HARDWARE_ROLES[h.role]}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </section>
      )}
      <section>
        <h2 class="text-lg font-semibold tracking-tight">标签</h2>
        <div class="mt-3 flex flex-wrap gap-1.5">
          {ai.tags.map((t) => (
            <a href={`/search/?q=${encodeURIComponent(t)}`} class="rounded-full border border-line bg-surface px-2.5 py-1 text-xs text-muted hover:border-teal/40 hover:text-teal">{t}</a>
          ))}
        </div>
      </section>
    </aside>
  </div>

  {similar.length > 0 && <Shelf shelf={{ key: ai.shelf, title: '相似项目', subtitle: '标签、分类、平台和硬件最接近的项目。', items: similar }} showAll={false} />}
  {moreInShelf.items.length > 0 && <Shelf shelf={moreInShelf} title={`更多${SHELVES[ai.shelf]}`} />}
</Base>

<script>
  for (const btn of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
    btn.addEventListener('click', async () => {
      const label = btn.querySelector<HTMLElement>('[data-copy-label]')!;
      try {
        await navigator.clipboard.writeText(btn.dataset.copy!);
        label.textContent = '已复制';
      } catch {
        label.textContent = '复制失败，请手动选择';
      }
      setTimeout(() => (label.textContent = '复制'), 2000);
    });
  }
</script>
