---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { owner, projects } from '../lib/projects.ts';
import { PLATFORMS, SHELVES } from '../lib/taxonomy.ts';

// 每张卡片带一段可搜索文本；项目只有几百个，前端直接过滤即可
const haystack = (p: (typeof projects)[number]) =>
  [p.ai.title, p.ai.summary, p.repo, owner(p), PLATFORMS[p.ai.platform], SHELVES[p.ai.shelf], ...p.ai.tags, ...p.ai.hardware.map((h) => h.name), ...p.ai.aiCapabilities.map((a) => a.name)]
    .join(' ')
    .toLowerCase();
---

<Base title="搜索" description="搜索开源 AIoT 项目">
  <div class="pt-8">
    <h1 class="text-2xl font-bold tracking-tight">搜索项目</h1>
    <div class="mt-4 flex max-w-xl items-center gap-2 rounded-xl border border-line bg-surface px-3 py-2 focus-within:border-teal/50">
      <svg viewBox="0 0 20 20" class="size-4 shrink-0 text-muted" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
        <circle cx="9" cy="9" r="6"></circle><path d="m14 14 4 4" stroke-linecap="round"></path>
      </svg>
      <input id="q" type="search" autofocus placeholder="语音助手、ESP32-S3、摄像头、机器人……" class="min-w-0 flex-1 bg-transparent text-sm outline-none placeholder:text-muted/70" aria-label="搜索关键词" />
    </div>
    <p id="status" class="mt-3 text-sm text-muted" aria-live="polite"></p>
  </div>
  <div id="results" class="mt-6 grid grid-cols-1 gap-x-4 gap-y-6 sm:grid-cols-2 lg:grid-cols-4">
    {projects.map((p) => (
      <div data-text={haystack(p)}>
        <ProjectCard project={p} />
      </div>
    ))}
  </div>
</Base>

<script>
  const input = document.querySelector<HTMLInputElement>('#q')!;
  const status = document.querySelector<HTMLElement>('#status')!;
  const items = [...document.querySelectorAll<HTMLElement>('#results > [data-text]')];

  function apply(q: string) {
    // 空格分隔的多个词需要全部命中
    const words = q.toLowerCase().split(/\s+/).filter(Boolean);
    let shown = 0;
    for (const el of items) {
      const hit = words.every((w) => el.dataset.text!.includes(w));
      el.hidden = !hit;
      if (hit) shown++;
    }
    status.textContent = words.length ? `找到 ${shown} 个项目` : `全部 ${items.length} 个项目`;
  }

  const initial = new URLSearchParams(location.search).get('q') ?? '';
  input.value = initial;
  apply(initial);
  input.addEventListener('input', () => {
    apply(input.value);
    const url = new URL(location.href);
    if (input.value) url.searchParams.set('q', input.value);
    else url.searchParams.delete('q');
    history.replaceState(null, '', url);
  });
</script>
