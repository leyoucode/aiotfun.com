---
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { allShelves, type ShelfDef } from '../../lib/projects.ts';

export function getStaticPaths() {
  return allShelves()
    .filter((s) => s.items.length > 0)
    .map((shelf) => ({ params: { key: shelf.key }, props: { shelf } }));
}

const { shelf } = Astro.props as { shelf: ShelfDef };
---

<Base title={shelf.title} description={shelf.subtitle || `${shelf.title}类的开源 AIoT 项目`}>
  <div class="pt-8">
    <a href="/" class="text-xs text-muted hover:text-teal">← 画廊</a>
    <h1 class="mt-2 text-2xl font-bold tracking-tight">{shelf.title}</h1>
    <p class="mt-1 text-sm text-muted">{shelf.subtitle} 共 {shelf.items.length} 个项目。</p>
  </div>
  <div class="mt-6 grid grid-cols-1 gap-x-4 gap-y-6 sm:grid-cols-2 lg:grid-cols-4">
    {shelf.items.map((p) => <ProjectCard project={p} />)}
  </div>
</Base>
